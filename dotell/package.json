{
  "name": "@joefuentes/dotell",
  "version": "1.1.0",
  "description": "Unified observability baseline for Next.js App Router apps",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters/supabase": {
      "import": "./dist/adapters/supabase.js",
      "types": "./dist/adapters/supabase.d.ts"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "observability",
    "analytics",
    "sentry",
    "posthog",
    "nextjs"
  ],
  "author": "Joe Fuentes",
  "license": "MIT",
  "dependencies": {
    "@sentry/nextjs": "^8.0.0",
    "posthog-js": "^1.57.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
